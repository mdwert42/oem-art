# Database Configuration
# For development, SQLite is used by default (no configuration needed)
# For production, use PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/art_oem
DATABASE_URL=sqlite:///./art_oem.db

# JWT Authentication Configuration
# IMPORTANT: Generate a secure random key for production!
# You can generate one with: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-change-this-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin User Configuration
# These credentials will be used to create/update the admin user
# Run `python seed_admin.py` after setting these values
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@art.oem
ADMIN_PASSWORD=changeme

# API Configuration
# API_HOST=0.0.0.0
# API_PORT=8000

# CORS Configuration (for production)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Social Media API Keys (for future use)
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_SHOP_NAME=
